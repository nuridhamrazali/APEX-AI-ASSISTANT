# Run npm run setup to generate .env.local with private credentials.
APP_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data
# Astra uses billed OpenAI API usage. Keep this key server-side.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
# Optional free local alternative: set LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Only for an authenticated remote Ollama service; local Ollama needs no key.
OLLAMA_API_KEY=
# Optional paid/cloud voice. Leave blank for browser speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_multilingual_v2
