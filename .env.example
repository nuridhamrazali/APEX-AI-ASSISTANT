# Copy to .env.local. Keys stay on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=e6b437b389c34041856d56d3cde1f494
FISH_AUDIO_MODEL=s2.1-pro-free

# Optional: exact public origins for a reverse proxy, comma-separated. No wildcards.
APEX_ALLOWED_ORIGINS=

# Hermes is the harness; Gemini remains the default model provider.
# Defaults: your home/hermes-agent and its .venv Python.
HERMES_SOURCE_DIR=
HERMES_PYTHON=
HERMES_MODEL=gemini-3.8-flash
HERMES_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional alternative provider key; otherwise GEMINI_API_KEY is used.
HERMES_API_KEY=
# Open this folder as a vault in Obsidian. Defaults to home/Documents/APEX-Memory.
OBSIDIAN_VAULT_PATH=
