{
  "name": "apex-ui",
  "version": "2.0.0",
  "description": "An animated autonomous-agent orb + reasoning-graph UI. Hand-written SVG/CSS, no 3D libraries.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "setup": "node scripts/setup.mjs",
    "check": "tsc --noEmit",
    "obsidian": "node --env-file-if-exists=.env.local --import tsx scripts/obsidian.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "lucide-react": "^0.511.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.184.0",
    "zod": "^4.0.0",
    "eventsource-parser": "^3.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.25"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
